{
  "name": "mandrain-keyword-backend",
  "version": "1.0.0",
  "description": "Mandrain Keyword Chrome Extension - AWS Lambda Backend",
  "type": "module",
  "scripts": {
    "build": "npm run build:session-init && npm run build:analyze",
    "build:session-init": "esbuild src/session-init/index.mjs --bundle --platform=node --target=node20 --format=esm --outfile=dist/session-init/index.mjs --external:@aws-sdk/*",
    "build:analyze": "esbuild src/analyze/index.mjs --bundle --platform=node --target=node20 --format=esm --outfile=dist/analyze/index.mjs --external:@aws-sdk/*",
    "package": "npm run build && npm run zip:session-init && npm run zip:analyze",
    "zip:session-init": "cd dist/session-init && zip -r ../session-init.zip index.mjs",
    "zip:analyze": "cd dist/analyze && zip -r ../analyze.zip index.mjs"
  },
  "dependencies": {
    "jose": "^5.x"
  },
  "devDependencies": {
    "esbuild": "^0.20.x"
  }
}
