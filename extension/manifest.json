{
  "manifest_version": 3,
  "name": "Chinese Slang Translator",
  "version": "1.0.0",
  "description": "Intelligent word analysis providing structured insights into literal meaning, subtext, and emotional tone.",
  "permissions": [
    "activeTab",
    "scripting",
    "storage"
  ],
  "host_permissions": [
    "<all_urls>"
  ],
  "content_scripts": [
    {
      "matches": [
        "<all_urls>"
      ],
      "js": [
        "content_script.js"
      ],
      "run_at": "document_start"
    }
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_title": "Chinese Slang Translator",
    "default_popup": "popup.html"
  },
  "web_accessible_resources": [
    {
      "resources": [
        "local_db.json",
        "styles.css"
      ],
      "matches": [
        "<all_urls>"
      ]
    }
  ],
  "icons": {
    "16": "images/icon-16.png",
    "48": "images/icon-48.png",
    "128": "images/icon-128.png"
  }
}
